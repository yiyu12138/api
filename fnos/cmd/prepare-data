#!/bin/bash
set -eu

DATA_DIR="$(realpath -e -- "$1")"
OWNER="$2:$3"
[ -d "$DATA_DIR" ] && [ "$DATA_DIR" != / ] || exit 1
FILES=(secret config.json config.json.tmp history.json history.json.tmp install-id install-id.tmp license license.tmp update-status.json api-balance.log api-balance-update.fpk)

# Migrate only application-owned files; never follow links into other NAS data.
for name in "${FILES[@]}"; do
  file="$DATA_DIR/$name"
  if [ -L "$file" ] || { [ -e "$file" ] && { [ ! -f "$file" ] || [ "$(stat -c %h -- "$file")" != 1 ]; }; }; then
    printf 'Unsafe application data file: %s\n' "$name" >&2
    exit 1
  fi
done
chown -- "$OWNER" "$DATA_DIR"
chmod 700 -- "$DATA_DIR"
for name in "${FILES[@]}"; do
  file="$DATA_DIR/$name"
  if [ -f "$file" ]; then
    chown -- "$OWNER" "$file"
    chmod 600 -- "$file"
  fi
done
